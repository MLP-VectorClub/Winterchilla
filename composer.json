{
  "name": "mlp-vectorclub/winterchilla",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "WentTheFox",
      "email": "mail@went.tf"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-pdo_sqlite": "*",
    "ext-posix": "*",
    "ext-redis": "*",
    "ext-xml": "*",
    "ext-zlib": "*",
    "airmanbzh/php-html-generator": "^1.0",
    "altorouter/altorouter": "^2.0",
    "cogpowered/finediff": "0.3.*",
    "doctrine/inflector": "^2.0",
    "elasticsearch/elasticsearch": "~7.0",
    "enshrined/svg-sanitize": "^0.22.0",
    "erusev/parsedown": "^1.7",
    "ezyang/htmlpurifier": "^4.8",
    "fightbulc/moment": "^1.28",
    "illuminate/container": "^10.0",
    "illuminate/hashing": "^10.0",
    "league/uri": "^7.0",
    "league/uri-components": "^7.0",
    "lefuturiste/monolog-discord-handler": "^0.3.1",
    "monolog/monolog": "^2.10.0",
    "nojacko/email-validator": "~1.0",
    "ongr/elasticsearch-dsl": "~7.0",
    "php-activerecord/php-activerecord": "dev-master",
    "psr/log": "^3.0.2",
    "ramsey/uuid": "^3.9",
    "restcord/restcord": "v9.x-dev#8646bdd6865e9cf1c8edb560e7a22622228e6e71",
    "robmorgan/phinx": "^0.16.0",
    "s1lentium/iptools": "^1.1",
    "seinopsys/oauth2-deviantart": "^1.0",
    "seinopsys/postgresql-database-class": "^3.0",
    "seinopsys/rgbacolor": "1.*",
    "swiftmailer/swiftmailer": "^6.0",
    "symfony/dotenv": "^6.0|^7.0",
    "twig/twig": "^3.0",
    "whichbrowser/parser": "^2.0",
    "wohali/oauth2-discord-new": "^1.0",
    "zircote/swagger-php": "^6.7"
  },
  "require-dev": {
    "ext-pcntl": "*",
    "kint-php/kint": "^2.2",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-browser": "^4.0",
    "phpstan/phpstan": "^2.2",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Browser\\": "tests/Browser/"
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/SeinopSys/php-activerecord"
    }
  ],
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}
