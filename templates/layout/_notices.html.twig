{# @var site_notices \App\Models\Notice[] #}
{% if env('READ_ONLY') %}
  <div class='notice warn align-center' id='read-only-notice'>
    <span class='typcn typcn-lock-closed'></span> This site is now in read-only mode, you can still look around but nothing can be changed.
    {% if read_only_url() %}To make changes, please visit the new site: <a href='{{ read_only_url() }}'>{{ read_only_url()|replace({'https://': '', 'http://': ''}) }}</a>.{% endif %}
  </div>
{% endif %}
{% if site_notices is defined and site_notices is not empty %}
  {% for notice in site_notices %}
    <div class='notice {{ notice.type }}'>{{ notice.message }}</div>
  {% endfor %}
{% endif %}
