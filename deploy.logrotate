# Log rotation for git-deploy-toolkit: installed as /etc/logrotate.d/git-deploy-winterchilla on each deploy
# and run by the nightly logrotate timer. See deploy.conf for the rest of the deploy setup.
#
# Retention follows the privacy policy (templates/about/privacy.html.twig, "Log Data"): server logs are
# "kept for up to 14 days and discarded afterwards". They contain visitor IP addresses; the app's error.log
# does too (plus referrers, request data and signed-in user IDs), so it gets the same treatment. The
# database "Application Log" is a separate thing with its own rule (IPs removed after 3 months, see
# scripts/clear_old_logged_ips.php) and isn't affected by any of this.
#
# `rotate 13` with `daily` is what makes that "up to 14 days": the current file holds at most one day and
# the 13 rotated ones the 13 days before it, so nothing is older than 14 days. (`rotate 14` would keep
# entries for up to ~15 days.) If the policy's number changes, change this to (days - 1).
#
# The old hand-made /etc/logrotate.d/mlpvc-rr entry never rotated anything (logrotate skipped it as an
# insecure directory), so nginx-access.log grew to ~1 GB.
@WORKTREE@/logs/nginx-access.log
@WORKTREE@/logs/nginx-error.log
@WORKTREE@/logs/error.log {
    su www-data www-data
    daily
    rotate 13
    missingok
    notifempty
    compress
    delaycompress
    # nginx and PHP keep these files open, so copy and truncate instead of moving them
    copytruncate
}
